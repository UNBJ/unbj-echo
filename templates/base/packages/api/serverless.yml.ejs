service: <%= projectName %>-api
frameworkVersion: '4'
useDotenv: true

provider:
  name: aws
  runtime: nodejs20.x
  region: us-east-2
  stage: ${opt:stage, 'dev'}
  environment:
    FIREBASE_PROJECT_ID: ${env:FIREBASE_PROJECT_ID}
    FIREBASE_CLIENT_EMAIL: ${env:FIREBASE_CLIENT_EMAIL}
    FIREBASE_PRIVATE_KEY: ${env:FIREBASE_PRIVATE_KEY}
    RESEND_API_KEY: ${env:RESEND_API_KEY}
    RESEND_FROM_EMAIL: ${env:RESEND_FROM_EMAIL, 'onboarding@resend.dev'}
    STRIPE_SECRET_KEY: ${env:STRIPE_SECRET_KEY}
    STRIPE_WEBHOOK_SECRET: ${env:STRIPE_WEBHOOK_SECRET}
    PORTAL_URL: ${env:NEXT_PUBLIC_PORTAL_URL, 'http://localhost:3000'}
    FIREBASE_STORAGE_BUCKET: ${env:NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET}
    STAGE: ${self:provider.stage}
  httpApi:
    cors:
      allowedOrigins:
        - '*'
      allowedHeaders:
        - Content-Type
        - Authorization
      allowedMethods:
        - GET
        - POST
        - PUT
        - PATCH
        - DELETE
        - OPTIONS

build:
  esbuild: false

plugins:
  - serverless-esbuild
  - serverless-offline

custom:
  esbuild:
    bundle: true
    minify: true
    sourcemap: false
    target: node20
    platform: node
    external:
      - '@aws-sdk/*'
  serverless-offline:
    httpPort: 3001
    lambdaPort: 3003
    noPrependStageInUrl: true

functions:
  <% if (archetype === 'plenarias') { %>
  # --- Iglesias ---
  listConventions:
    handler: src/handlers/churches/list-conventions.handler
    events:
      - httpApi:
          path: /conventions
          method: GET

  searchChurches:
    handler: src/handlers/churches/search.handler
    events:
      - httpApi:
          path: /churches/search
          method: POST
  <% } %>

  # --- Registros ---
  createRegistration:
    handler: src/handlers/registrations/create.handler
    events:
      - httpApi:
          path: /registrations
          method: POST

  getRegistration:
    handler: src/handlers/registrations/get.handler
    events:
      - httpApi:
          path: /registrations/{token}
          method: GET

  # --- Pagos ---
  createPaymentIntent:
    handler: src/handlers/payments/create-intent.handler
    events:
      - httpApi:
          path: /payments/create-intent
          method: POST

  stripeWebhook:
    handler: src/handlers/payments/webhook.handler
    events:
      - httpApi:
          path: /webhooks/stripe
          method: POST

  # --- Admin ---
  adminListRegistrations:
    handler: src/handlers/admin/list-registrations.handler
    events:
      - httpApi:
          path: /admin/registrations
          method: GET

  adminGetRegistration:
    handler: src/handlers/admin/get-registration.handler
    events:
      - httpApi:
          path: /admin/registrations/{id}
          method: GET

  adminResendAccessLink:
    handler: src/handlers/admin/resend-access.handler
    events:
      - httpApi:
          path: /admin/registrations/{id}/resend-access
          method: POST

  adminUpdatePayment:
    handler: src/handlers/admin/update-payment.handler
    events:
      - httpApi:
          path: /admin/registrations/{id}/payment
          method: PATCH

  <% if (archetype === 'plenarias') { %>
  adminUpdateCarta:
    handler: src/handlers/admin/update-carta.handler
    events:
      - httpApi:
          path: /admin/registrations/{id}/carta
          method: PATCH

  adminUpdateDelegateType:
    handler: src/handlers/admin/update-delegate-type.handler
    events:
      - httpApi:
          path: /admin/registrations/{id}/delegate-type
          method: PATCH
  <% } %>

  adminStats:
    handler: src/handlers/admin/stats.handler
    events:
      - httpApi:
          path: /admin/stats
          method: GET

  adminExport:
    handler: src/handlers/admin/export.handler
    events:
      - httpApi:
          path: /admin/export
          method: GET

  adminGetConfig:
    handler: src/handlers/admin/config.handler
    events:
      - httpApi:
          path: /admin/config
          method: GET

  adminUpdateConfig:
    handler: src/handlers/admin/config.handler
    events:
      - httpApi:
          path: /admin/config
          method: PATCH

  <% if (archetype === 'plenarias') { %>
  adminListExceptions:
    handler: src/handlers/admin/exceptions.handler
    events:
      - httpApi:
          path: /admin/exceptions
          method: GET

  adminCreateException:
    handler: src/handlers/admin/exceptions.handler
    events:
      - httpApi:
          path: /admin/exceptions
          method: POST

  adminDeleteException:
    handler: src/handlers/admin/exceptions.handler
    events:
      - httpApi:
          path: /admin/exceptions/{churchId}
          method: DELETE
  <% } %>

  adminListUsers:
    handler: src/handlers/admin/users.handler
    events:
      - httpApi:
          path: /admin/users
          method: GET

  adminCreateUser:
    handler: src/handlers/admin/users.handler
    events:
      - httpApi:
          path: /admin/users
          method: POST

  adminDeleteUser:
    handler: src/handlers/admin/users.handler
    events:
      - httpApi:
          path: /admin/users/{uid}
          method: DELETE

  adminCheckIn:
    handler: src/handlers/admin/checkin.handler
    events:
      - httpApi:
          path: /admin/checkin
          method: POST

  <% if (archetype === 'plenarias') { %>
  # --- Carta ---
  cartaUploadUrl:
    handler: src/handlers/registrations/carta-upload-url.handler
    events:
      - httpApi:
          path: /registrations/carta-upload-url
          method: POST

  cartaSubmit:
    handler: src/handlers/registrations/carta-submit.handler
    events:
      - httpApi:
          path: /registrations/carta-submit
          method: POST
  <% } %>

<%- moduleEndpointsYaml %>
