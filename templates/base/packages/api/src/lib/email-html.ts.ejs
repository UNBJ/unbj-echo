import { branding } from '@unbj/shared'

const FONT_STACK = '"Geist","Inter",-apple-system,"Segoe UI",Roboto,Arial,Helvetica,sans-serif'

function escapeHtml(value: string | null | undefined): string {
  return String(value ?? '').replace(/[&<>'"]/g, (char) => ({
    '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;',
  })[char]!)
}

export function confirmationEmailHtml(opts: {
  fullName: string
  portalUrl: string
  eventName: string
  churchName?: string | null
  conventionName?: string | null
}): string {
  const fullName = escapeHtml(opts.fullName)
  const portalUrl = escapeHtml(opts.portalUrl)
  const eventName = escapeHtml(opts.eventName)
  const churchName = opts.churchName ? escapeHtml(opts.churchName) : null
  const conventionName = opts.conventionName ? escapeHtml(opts.conventionName) : null

  return `<!DOCTYPE html>
<html lang="es">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"></head>
<body style="margin:0;padding:0;background:#FAFAFA;font-family:${FONT_STACK};">
  <table width="100%" cellpadding="0" cellspacing="0" style="background:#FAFAFA;padding:32px 16px;">
    <tr><td align="center">
      <table width="560" cellpadding="0" cellspacing="0" style="max-width:560px;width:100%;background:#ffffff;border-radius:14px;overflow:hidden;border:1px solid #E4E4E7;">

        <!-- Header -->
        <tr><td style="background:#09090B;padding:20px 32px;">
          <table width="100%" cellpadding="0" cellspacing="0">
            <tr>
              <td>
                <span style="color:#FAFAFA;font-size:15px;font-weight:600;letter-spacing:0.08em;text-transform:uppercase;">${eventName}</span>
              </td>
            </tr>
          </table>
        </td></tr>

        <!-- Content -->
        <tr><td style="padding:36px 32px 28px;">

          <!-- Success icon row -->
          <table width="100%" cellpadding="0" cellspacing="0" style="margin-bottom:24px;">
            <tr>
              <td>
                <div style="display:inline-block;background:${branding.accentColor};color:#ffffff;border-radius:50%;width:48px;height:48px;line-height:48px;text-align:center;font-size:22px;font-weight:600;">✓</div>
              </td>
            </tr>
          </table>

          <h1 style="margin:0 0 8px;font-size:22px;font-weight:600;letter-spacing:-0.01em;color:#18181B;">¡Tu registro fue exitoso!</h1>
          <p style="margin:0 0 20px;font-size:15px;color:#52525B;">Hola <strong style="color:#18181B;">${fullName}</strong>,</p>
          <p style="margin:0 0 20px;font-size:15px;color:#3F3F46;line-height:1.6;">
            Tu registro para el evento <strong>${eventName}</strong> ha sido recibido correctamente.
          </p>

          ${(churchName || conventionName) ? `
          <!-- Info box -->
          <table width="100%" cellpadding="0" cellspacing="0" style="background:#F4F4F5;border-radius:10px;border:1px solid #E4E4E7;margin:0 0 24px;">
            <tr><td style="padding:16px 20px;">
              <table width="100%" cellpadding="0" cellspacing="0">
                ${churchName ? `
                <tr>
                  <td style="padding:6px 0;${conventionName ? 'border-bottom:1px solid #E4E4E7;' : ''}">
                    <span style="font-size:11px;color:#71717A;text-transform:uppercase;letter-spacing:0.08em;">Organización / Iglesia</span><br>
                    <span style="font-size:14px;color:#18181B;font-weight:600;">${churchName}</span>
                  </td>
                </tr>
                ` : ''}
                ${conventionName ? `
                <tr>
                  <td style="padding:6px 0;">
                    <span style="font-size:11px;color:#71717A;text-transform:uppercase;letter-spacing:0.08em;">Asociación / Convención</span><br>
                    <span style="font-size:14px;color:#18181B;font-weight:600;">${conventionName}</span>
                  </td>
                </tr>
                ` : ''}
              </table>
            </td></tr>
          </table>
          ` : ''}

          <p style="margin:0 0 20px;font-size:15px;color:#3F3F46;line-height:1.6;">
            El siguiente paso es completar tu pago e información adicional en tu portal personal.
          </p>

          <!-- Button -->
          <table cellpadding="0" cellspacing="0" style="margin:0 0 24px;">
            <tr>
              <td style="background:${branding.accentColor};border-radius:10px;">
                <a href="${portalUrl}" style="display:inline-block;padding:14px 28px;color:#ffffff;font-size:14px;font-weight:500;text-decoration:none;letter-spacing:0.01em;">
                  Acceder a mi portal personal →
                </a>
              </td>
            </tr>
          </table>

          <p style="margin:0;font-size:12px;color:#71717A;line-height:1.6;">
            Guarda este correo — el enlace de arriba es tu acceso personal al proceso de registro.
            No lo compartas con nadie más.
          </p>

        </td></tr>

        <!-- Footer -->
        <tr><td style="background:#FAFAFA;border-top:1px solid #E4E4E7;padding:16px 32px;text-align:center;">
          <p style="margin:0;font-size:11px;color:#71717A;letter-spacing:0.02em;">
            ${eventName} · Generado por ${branding.platform}
          </p>
        </td></tr>

      </table>
    </td></tr>
  </table>
</body>
</html>`
}

