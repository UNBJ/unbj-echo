import type { APIGatewayProxyEventV2, APIGatewayProxyResultV2 } from 'aws-lambda'
import { z } from 'zod'
import { getDb } from '../../lib/firebase'
import { verifyAdminToken } from '../../lib/auth'
import { ok, badRequest, notFound, serverError } from '../../lib/response'
import { generateAndSaveNomination } from '../../lib/nomination'
import type { Registration, RegistrationStatus } from '@plenarias/shared'

const schema = z.discriminatedUnion('action', [
  z.object({ action: z.literal('approve') }),
  z.object({ action: z.literal('reject'), reason: z.string().min(1) }),
])

export async function handler(event: APIGatewayProxyEventV2): Promise<APIGatewayProxyResultV2> {
  const admin = await verifyAdminToken(event)
  if (!admin) {
    return { statusCode: 401, body: JSON.stringify({ error: 'Unauthorized' }) }
  }

  const id = event.pathParameters?.['id']
  if (!id) return notFound()

  let body: unknown
  try {
    body = JSON.parse(event.body ?? '{}')
  } catch {
    return badRequest('Invalid JSON')
  }

  const parsed = schema.safeParse(body)
  if (!parsed.success) {
    return badRequest(parsed.error.issues[0]?.message ?? 'Invalid input')
  }

  const db = getDb()
  const ref = db.collection('registrations').doc(id)

  try {
    const snap = await ref.get()
    if (!snap.exists) return notFound('Registro no encontrado')

    const reg = snap.data() as Registration
    const allowedStatuses: RegistrationStatus[] = ['pending_onsite_payment', 'payment_submitted']
    if (!allowedStatuses.includes(reg.status)) {
      return badRequest('Este registro no tiene un pago pendiente de revisión')
    }
    if (reg.paymentMethod !== 'cash') {
      return badRequest('Solo se pueden aprobar o rechazar pagos en efectivo desde el panel')
    }

    const now = new Date().toISOString()

    if (parsed.data.action === 'approve') {
      <% if (archetype === 'plenarias') { %>
      await ref.update({
        status: 'carta_pending' as RegistrationStatus,
        paymentApprovedAt: now,
        paymentApprovedBy: admin.email,
        updatedAt: now,
      })
      <% } else { %>
      await ref.update({
        paymentApprovedAt: now,
        paymentApprovedBy: admin.email,
        updatedAt: now,
      })
      
      const updatedRegSnap = await ref.get()
      const updatedReg = updatedRegSnap.data() as Registration
      await generateAndSaveNomination(db, ref, updatedReg)
      <% } %>
    } else {
      await ref.update({
        status: 'payment_rejected' as RegistrationStatus,
        paymentRejectedReason: parsed.data.reason,
        updatedAt: now,
      })
    }

    return ok({ success: true })
  } catch (err) {
    console.error('update-payment error:', err)
    return serverError()
  }
}
