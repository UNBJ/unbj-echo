import type { APIGatewayProxyEventV2, APIGatewayProxyResultV2 } from 'aws-lambda'
import { getDb } from '../../lib/firebase'
import { verifyAdminToken } from '../../lib/auth'
import { ok, serverError } from '../../lib/response'
import type { Registration } from '@unbj/shared'

const PAGE_SIZE = 20

export async function handler(event: APIGatewayProxyEventV2): Promise<APIGatewayProxyResultV2> {
  const admin = await verifyAdminToken(event)
  if (!admin) {
    return { statusCode: 401, body: JSON.stringify({ error: 'Unauthorized' }) }
  }

  const qs = event.queryStringParameters ?? {}
  const status = qs['status'] ?? ''
  const delegateType = qs['delegateType'] ?? ''
  const search = (qs['search'] ?? '').toLowerCase().trim()
  const cursor = qs['cursor'] ?? ''
  if (search.length === 1 || search.length > 32) {
    return { statusCode: 400, body: JSON.stringify({ error: 'La búsqueda debe tener entre 2 y 32 caracteres.' }) }
  }

  try {
    const db = getDb()
    let query: FirebaseFirestore.Query = db.collection('registrations')

    if (status) query = query.where('status', '==', status)
    if (delegateType) query = query.where('delegateType', '==', delegateType)
    if (search) query = query.where('searchTerms', 'array-contains', search)

    query = query.orderBy('createdAt', 'desc')

    if (cursor) {
      const cursorDoc = await db.collection('registrations').doc(cursor).get()
      if (cursorDoc.exists) query = query.startAfter(cursorDoc)
    }

    const [snap, countSnap] = await Promise.all([
      query.limit(PAGE_SIZE + 1).get(),
      query.count().get(),
    ])
    const hasNextPage = snap.docs.length > PAGE_SIZE
    const pageDocs = hasNextPage ? snap.docs.slice(0, PAGE_SIZE) : snap.docs
    const registrations = pageDocs.map((d) => {
      const data = d.data() as Registration
      const { qrToken: _q, ...rest } = data
      return rest
    })

    return ok({
      registrations,
      total: countSnap.data().count,
      pageSize: PAGE_SIZE,
      nextCursor: hasNextPage ? pageDocs[pageDocs.length - 1]?.id ?? null : null,
    })
  } catch (err) {
    console.error('list-registrations error:', err)
    return serverError()
  }
}
