import type { APIGatewayProxyEventV2, APIGatewayProxyResultV2 } from 'aws-lambda'
import { getDb } from '../../lib/firebase'
import { verifyAdminToken } from '../../lib/auth'
import { ok, serverError } from '../../lib/response'
import type { Registration } from '@unbj/shared'

const CACHE_TTL_MS = 60_000
let cachedStats: { expiresAt: number; value: Record<string, unknown> } | null = null

export async function handler(event: APIGatewayProxyEventV2): Promise<APIGatewayProxyResultV2> {
  const admin = await verifyAdminToken(event)
  if (!admin) return { statusCode: 401, body: JSON.stringify({ error: 'Unauthorized' }) }

  try {
    if (cachedStats && cachedStats.expiresAt > Date.now()) {
      return ok(cachedStats.value)
    }

    const db = getDb()
    const snap = await db.collection('registrations').get()
    const registrations = snap.docs.map((d) => d.data() as Registration)

    const byStatus: Record<string, number> = {}
    <% if (archetype === 'plenarias') { %>
    const byDelegate: Record<string, number> = {}
    const byConvention: Record<string, number> = {}
    const topChurches: Record<string, number> = {}
    <% } else if (archetype === 'roles') { %>
    const byTicketTier: Record<string, number> = {}
    <% } %>

    for (const r of registrations) {
      byStatus[r.status] = (byStatus[r.status] ?? 0) + 1
      <% if (archetype === 'plenarias') { %>
      byDelegate[r.delegateType ?? 'sin_asignar'] = (byDelegate[r.delegateType ?? 'sin_asignar'] ?? 0) + 1
      byConvention[r.conventionName ?? 'Sin asignar'] = (byConvention[r.conventionName ?? 'Sin asignar'] ?? 0) + 1
      topChurches[r.churchName ?? 'Sin asignar'] = (topChurches[r.churchName ?? 'Sin asignar'] ?? 0) + 1
      <% } else if (archetype === 'roles') { %>
      byTicketTier[r.ticketTier ?? 'sin_asignar'] = (byTicketTier[r.ticketTier ?? 'sin_asignar'] ?? 0) + 1
      <% } %>
    }

    <% if (archetype === 'plenarias') { %>
    const sortedChurches = Object.entries(topChurches)
      .sort((a, b) => b[1] - a[1])
      .slice(0, 10)
      .map(([name, count]) => ({ name, count }))
    <% } %>

    const value = {
      total: registrations.length,
      byStatus,
      <% if (archetype === 'plenarias') { %>
      byDelegate,
      byConvention,
      topChurches: sortedChurches,
      <% } else if (archetype === 'roles') { %>
      byTicketTier,
      <% } %>
    }
    cachedStats = { value, expiresAt: Date.now() + CACHE_TTL_MS }
    return ok(value)
  } catch (err) {
    console.error('stats error:', err)
    return serverError()
  }
}
