            >
              Acceder al Panel de Votación
            </a>
          </div>
        </div>
      )}

    </div>
  )
}

function StatusCard({
  icon,
  title,
  description,
  color,
  action,
  note,
}: {
  icon: React.ReactNode
  title: string
  description: string
  color: 'success' | 'warning' | 'error'
  action?: { label: string; href: string }
  note?: string
}) {
  const iconBgMap = {
    success: 'bg-accent',
    warning: 'bg-warning/10',
    error: 'bg-error/10',
  }
  const badgeMap = {
    success: 'bg-accent text-white',
    warning: 'bg-warning/10 text-warning',
    error: 'bg-error/10 text-error',
  }
  const badgeLabelMap = {
    success: 'Completado',
    warning: 'En proceso',
    error: 'Requiere atención',
  }

  return (
    <div className="bg-bg-card border border-border rounded-xl shadow-card">
      <div className="p-6">
        <div className="flex items-start gap-4">
          <div className={`w-10 h-10 rounded-lg flex items-center justify-center flex-shrink-0 ${iconBgMap[color]}`}>
            {icon}
          </div>
          <div className="flex-1">
            <div className="flex items-center gap-2 mb-1 flex-wrap">
              <h2 className="text-base font-heading font-semibold tracking-tight text-text-primary">{title}</h2>
              <span className={`text-[10px] font-semibold px-2 py-0.5 rounded-full ${badgeMap[color]}`}>
                {badgeLabelMap[color]}
              </span>
            </div>
            <p className="text-sm text-text-secondary leading-relaxed">{description}</p>

            {note && (
              <div className="mt-4 bg-bg-subtle border border-border rounded-lg px-3 py-2.5">
                <p className="text-xs text-text-secondary leading-relaxed">{note}</p>
              </div>
            )}

            {action && (
              <a
                href={action.href}
                className="inline-block mt-4 bg-accent hover:bg-accent-hover text-white font-medium px-5 py-2.5 rounded-lg text-sm transition-all duration-150 active:scale-[0.98] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/50"
              >
                {action.label}
              </a>
            )}
          </div>
        </div>
      </div>
    </div>
  )
}
