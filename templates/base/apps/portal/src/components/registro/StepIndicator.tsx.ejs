import { clsx } from 'clsx'
import { Check } from 'lucide-react'

const STEPS = [
  <% if (archetype === 'plenarias') { %>
  { label: 'Iglesia' },
  <% } %>
  { label: 'Datos personales' },
  <% if (archetype === 'roles') { %>
  { label: 'Entrada' },
  <% } %>
  { label: 'Confirmación' },
]

interface StepIndicatorProps {
  currentStep: number
  totalSteps: number
}

export function StepIndicator({ currentStep, totalSteps }: StepIndicatorProps) {
  return (
    <div className="w-full mb-8">
      {/* Step label */}
      <p className="text-[11px] text-text-secondary tracking-[0.14em] uppercase text-center mb-5">
        Paso {currentStep} de {totalSteps}
      </p>

      <div className="flex items-center">
        {STEPS.map((step, i) => {
          const num = i + 1
          const done = num < currentStep
          const active = num === currentStep
          const inactive = !done && !active

          return (
            <div key={step.label} className="flex items-center flex-1 last:flex-none">
              {/* Step circle + label */}
              <div className="flex flex-col items-center gap-2 relative">
                <div
                  className={clsx(
                    'w-8 h-8 rounded-full flex items-center justify-center text-sm font-semibold transition-all duration-200',
                    done && 'bg-accent text-white shadow-sm',
                    active && 'bg-accent text-white shadow-sm ring-4 ring-accent/20',
                    inactive && 'bg-bg-card border-2 border-border text-text-secondary'
                  )}
                >
                  {done
                    ? <Check className="w-3.5 h-3.5 stroke-[2.5]" />
                    : <span className={clsx('text-[13px]', active ? 'text-white' : 'text-text-secondary')}>{num}</span>
                  }
                </div>
                <span
                  className={clsx(
                    'text-[11px] whitespace-nowrap font-medium tracking-wide',
                    active && 'text-text-primary',
                    done && 'text-text-primary/60',
                    inactive && 'text-text-secondary'
                  )}
                >
                  {step.label}
                </span>
              </div>

              {/* Connector line */}
              {i < STEPS.length - 1 && (
                <div className="flex-1 mx-3 mb-5 relative h-px">
                  <div className="absolute inset-0 bg-border" />
                  <div
                    className="absolute inset-0 bg-accent origin-left transition-transform duration-300"
                    style={{ transform: done ? 'scaleX(1)' : 'scaleX(0)' }}
                  />
                </div>
              )}
            </div>
          )
        })}
      </div>
    </div>
  )
}
