'use client'

import { useState } from 'react'
import { AnimatePresence, motion, useReducedMotion } from 'framer-motion'
import { StepIndicator } from './StepIndicator'
import { Step2Datos } from './Step2Datos'
import { Step3Confirmacion } from './Step3Confirmacion'

<% if (archetype === 'plenarias') { %>
import { Step1Iglesia } from './Step1Iglesia'
import type { ChurchSelection } from './Step1Iglesia'
<% } %>

<% if (archetype === 'roles') { %>
import { Step2Tier } from './Step2Tier'
<% } %>

export interface RegistroState {
  fullName: string
  email: string
  phone: string
  birthDate: string
  extraFields: Record<string, string>
  <% if (archetype === 'plenarias') { %>
  church: ChurchSelection | null
  <% } %>
  <% if (archetype === 'roles') { %>
  ticketTier: 'general' | 'student' | 'vip' | null
  <% } %>
}

const initialState: RegistroState = {
  fullName: '',
  email: '',
  phone: '',
  birthDate: '',
  extraFields: {},
  <% if (archetype === 'plenarias') { %>
  church: null,
  <% } %>
  <% if (archetype === 'roles') { %>
  ticketTier: null,
  <% } %>
}

export function RegistroFlow() {
  <% if (archetype === 'standard') { %>
  const [step, setStep] = useState<1 | 2>(1)
  <% } else { %>
  const [step, setStep] = useState<1 | 2 | 3>(1)
  <% } %>
  const [state, setState] = useState<RegistroState>(initialState)
  const reduceMotion = useReducedMotion()

  function updateState(partial: Partial<RegistroState>) {
    setState((prev) => ({ ...prev, ...partial }))
  }

  return (
    <div className="w-full max-w-xl">
      <StepIndicator currentStep={step} totalSteps={<%= archetype === 'standard' ? 2 : 3 %>} />

      <AnimatePresence mode="wait" initial={false}>
        <motion.div
          key={step}
          initial={reduceMotion ? false : { opacity: 0, x: 16 }}
          animate={{ opacity: 1, x: 0 }}
          exit={reduceMotion ? undefined : { opacity: 0, x: -16 }}
          transition={{ duration: 0.25, ease: [0.16, 1, 0.3, 1] }}
        >

      {/* --- STANDARD ARCHETYPE FLOW --- */}
      <% if (archetype === 'standard') { %>
        {step === 1 && (
          <Step2Datos
            state={state}
            onBack={() => {}}
            onNext={(datos) => {
              updateState(datos)
              setStep(2)
            }}
          />
        )}

        {step === 2 && (
          <Step3Confirmacion
            state={state}
            onBack={() => setStep(1)}
          />
        )}
      <% } %>

      {/* --- ROLES ARCHETYPE FLOW --- */}
      <% if (archetype === 'roles') { %>
        {step === 1 && (
          <Step2Datos
            state={state}
            onBack={() => {}}
            onNext={(datos) => {
              updateState(datos)
              setStep(2)
            }}
          />
        )}

        {step === 2 && (
          <Step2Tier
            selected={state.ticketTier}
            onBack={() => setStep(1)}
            onNext={(ticketTier) => {
              updateState({ ticketTier })
              setStep(3)
            }}
          />
        )}

        {step === 3 && (
          <Step3Confirmacion
            state={state}
            onBack={() => setStep(2)}
          />
        )}
      <% } %>

      {/* --- PLENARIAS ARCHETYPE FLOW --- */}
      <% if (archetype === 'plenarias') { %>
        {step === 1 && (
          <Step1Iglesia
            selected={state.church}
            onNext={(church) => {
              updateState({ church })
              setStep(2)
            }}
          />
        )}

        {step === 2 && (
          <Step2Datos
            state={state}
            onBack={() => setStep(1)}
            onNext={(datos) => {
              updateState(datos)
              setStep(3)
            }}
          />
        )}

        {step === 3 && state.church && (
          <Step3Confirmacion
            state={state}
            onBack={() => setStep(2)}
          />
        )}
      <% } %>
        </motion.div>
      </AnimatePresence>
    </div>
  )
}
