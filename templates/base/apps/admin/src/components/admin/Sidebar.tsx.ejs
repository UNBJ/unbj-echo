'use client'

import Link from 'next/link'
import { usePathname, useRouter } from 'next/navigation'
import { useAuth } from '@/lib/auth'
import { LayoutList, LogOut, BarChart2, Settings, Building2, Users, ScanLine, Vote } from 'lucide-react'
import { clsx } from 'clsx'
import { Monogram } from '@/components/ui/Monogram'
import { ThemeToggle } from '@/components/ui/ThemeToggle'

const navItems = [
  { href: '/stats', label: 'Estadísticas', icon: BarChart2 },
  { href: '/registros', label: 'Registros', icon: LayoutList },
  { href: '/checkin', label: 'Check-in', icon: ScanLine },
  <% if (archetype === 'plenarias') { %>
  { href: '/excepciones', label: 'Excepciones', icon: Building2 },
  <% } %>
  <% if (modules.includes('voting')) { %>
  { href: '/votaciones', label: 'Votaciones', icon: Vote },
  <% } %>
  { href: '/config', label: 'Configuración', icon: Settings },
  { href: '/admins', label: 'Administradores', icon: Users },
]

export function Sidebar() {
  const pathname = usePathname()
  const router = useRouter()
  const { logout, user } = useAuth()

  async function handleLogout() {
    await logout()
    router.replace('/login')
  }

  return (
    <aside className="w-60 bg-bg-sidebar flex flex-col h-full shrink-0">
      <div className="flex items-center gap-3 px-5 py-5 border-b border-white/10">
        <Monogram size="sm" />
        <div className="min-w-0">
          <p className="truncate text-white font-semibold text-sm leading-tight"><%= eventName %></p>
          <p className="text-text-on-dark/60 text-xs mt-0.5">Panel Admin</p>
        </div>
      </div>

      <nav className="flex-1 px-3 py-4 flex flex-col gap-0.5">
        {navItems.map((item) => {
          const Icon = item.icon
          const active = pathname.startsWith(item.href)
          return (
            <Link
              key={item.href}
              href={item.href}
              className={clsx(
                'relative flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors duration-150',
                active
                  ? 'bg-bg-sidebar-hover text-white'
                  : 'text-text-on-dark/70 hover:bg-bg-sidebar-hover hover:text-white'
              )}
            >
              {active && (
                <span className="absolute left-0 top-1/2 h-5 w-0.5 -translate-y-1/2 rounded-full bg-accent" />
              )}
              <Icon className="w-4 h-4 shrink-0" />
              {item.label}
            </Link>
          )
        })}
      </nav>

      <div className="px-3 py-4 border-t border-white/10">
        <div className="flex items-center justify-between gap-2 px-3 mb-2">
          <p className="text-xs text-text-on-dark/60 truncate">{user?.email}</p>
          <ThemeToggle className="border-white/10 bg-transparent hover:bg-bg-sidebar-hover" />
        </div>
        <button
          onClick={handleLogout}
          className="flex items-center gap-3 px-3 py-2 rounded-lg text-sm text-text-on-dark/70 hover:bg-bg-sidebar-hover hover:text-white transition-colors duration-150 w-full"
        >
          <LogOut className="w-4 h-4 shrink-0" />
          Cerrar sesión
        </button>
      </div>
    </aside>
  )
}
