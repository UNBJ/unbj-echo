rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Todo acceso de Storage se concede exclusivamente mediante URLs firmadas
    // emitidas por el backend. Nunca confiar en un token de portal como identidad
    // de Firebase Storage.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
